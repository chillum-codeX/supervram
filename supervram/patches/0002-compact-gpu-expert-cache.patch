+void ggml_backend_sched_set_expert_cache(ggml_backend_sched_t sched, const struct ggml_backend_sched_expert_cache_params * params) {
+    GGML_ASSERT(sched);
+    if (sched->expert_cache) {
+        for (int i = 0; i < sched->n_backends; i++) {
+            ggml_backend_synchronize(sched->backends[i]);
+        }
+        ggml_backend_sched_expert_cache_free_buffers(sched->expert_cache);
+        delete sched->expert_cache;
+        sched->expert_cache = nullptr;
+    }
+    if (params == NULL || params->capacity_bytes == 0) {
+        return;
+    }
+    GGML_ASSERT(sched->n_copies == 1 && "expert cache does not support pipeline parallel copies");
+    GGML_ASSERT(sched->n_backends > 1 && "expert cache requires a device backend in addition to the CPU");
+    sched->expert_cache = new ggml_backend_sched_expert_cache();
+    sched->expert_cache->params = *params;
+    memset(&sched->expert_cache->stats, 0, sizeof(sched->expert_cache->stats));
+    sched->expert_cache->layout_dirty = true;
+}
+
+bool ggml_backend_sched_expert_cache_enabled(ggml_backend_sched_t sched) {
+    GGML_ASSERT(sched);
+    return sched->expert_cache != nullptr;
+}
+
+void ggml_backend_sched_get_expert_cache_stats(ggml_backend_sched_t sched, struct ggml_backend_sched_expert_cache_stats * stats) {
+    GGML_ASSERT(sched && stats);
+    if (sched->expert_cache) {
+        *stats = sched->expert_cache->stats;
+    } else {
+        memset(stats, 0, sizeof(*stats));
+    }
+}
+
+void ggml_backend_sched_reset_expert_cache_stats(ggml_backend_sched_t sched) {
+    GGML_ASSERT(sched);
+    if (sched->expert_cache) {
+        struct ggml_backend_sched_expert_cache_stats & s = sched->expert_cache->stats;
+        const uint64_t n_tensors = s.n_tensors, n_slots = s.n_slots_total, slot_bytes = s.slot_bytes_total;
+        memset(&s, 0, sizeof(s));
+        s.n_tensors = n_tensors;
+        s.n_slots_total = n_slots;
+        s.slot_bytes_total = slot_bytes;
+    }
+}
