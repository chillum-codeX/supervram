+++ b/tools/llama-bench/llama-bench.cpp
@@ -288,10 +288,19 @@ static const char * moe_expert_storage_str(llama_moe_expert_storage storage) {
     switch (storage) {
         case LLAMA_MOE_EXPERT_STORAGE_RESIDENT: return "resident";
         case LLAMA_MOE_EXPERT_STORAGE_MMAP:     return "mmap";
+        case LLAMA_MOE_EXPERT_STORAGE_CACHE:    return "cache";
         default: GGML_ABORT("invalid MoE expert storage");
     }
 }
 
+static const char * moe_expert_cache_policy_str(llama_moe_expert_cache_policy policy) {
