+// expert cache (SuperVRAM): compact device slots for host-resident MoE expert weights
+#define GGML_SCHED_EXPERT_CACHE_PAD 512 // extra zeroed bytes after the last slot (MMQ reads a little past the end)
+
+struct ggml_backend_sched_expert_tensor {
+    struct ggml_tensor *  weight     = nullptr; // host weight {ne0, ne1, n_expert}
+    int                   backend_id = -1;      // device backend that executes the consuming MUL_MAT_ID
+    ggml_backend_buffer_t buffer     = nullptr; // device buffer: [slots | pad | ids remap]
+    size_t                slots_nbytes = 0;
+    size_t                ids_offset   = 0;
+    size_t                ids_nbytes   = 0;     // capacity for the remapped ids
+    int64_t               n_expert    = 0;
+    size_t                expert_size = 0;      // nb[2]
+    int                   n_slots     = 0;
+
+    std::vector<int32_t>  slot_of_expert;       // [n_expert]  -1 when not resident
+    std::vector<int32_t>  expert_of_slot;       // [n_slots]   -1 when empty
+    std::vector<uint64_t> last_use;             // [n_slots]   tick of last use
+    std::vector<uint32_t> use_count;            // [n_slots]
+    uint64_t              tick = 0;
+
+    // per-graph tensors, live in sched->ctx and are rebuilt by ggml_backend_sched_split_graph
+    struct ggml_tensor * slots_view = nullptr;  // {ne0, ne1, n_slots} on the device, pre-allocated in `buffer`
+    struct ggml_tensor * ids_remap  = nullptr;  // same layout as the node's ids tensor, pre-allocated in `buffer`
+    struct ggml_tensor * ids_orig   = nullptr;  // the node's original ids tensor (logical expert ids)
+};
+
+struct ggml_backend_sched_expert_cache {
+    struct ggml_backend_sched_expert_cache_params params;
+    struct ggml_backend_sched_expert_cache_stats  stats;
+    std::unordered_map<struct ggml_tensor *, ggml_backend_sched_expert_tensor> tensors;
+    bool layout_dirty = true;
+
+    // scratch
+    std::vector<int32_t> ids_host;
+    std::vector<int32_t> remap_host;
+    std::vector<uint8_t> used;
+};
+
 struct ggml_backend_sched {
     bool is_reset; // true if the scheduler has been reset since the last graph split
     bool is_alloc;
@@ -831,6 +869,8 @@ struct ggml_backend_sched {
 
     bool op_offload;
 
+    struct ggml_backend_sched_expert_cache * expert_cache; // NULL when disabled
+
     int debug;
 
     // used for debugging graph reallocations [GGML_SCHED_DEBUG_REALLOC]
@@ -875,6 +915,312 @@ static void ggml_backend_sched_graph_inputs_grow(ggml_backend_sched_t sched) {
     sched->graph_inputs_capacity = new_cap;
 }
 
+//
+// expert cache helpers
+//
+
+// returns the host expert weight of `node` if the expert cache should handle it, NULL otherwise
+static struct ggml_tensor * ggml_backend_sched_expert_cache_weight(ggml_backend_sched_t sched, const struct ggml_tensor * node) {
+    if (sched->expert_cache == NULL || node->op != GGML_OP_MUL_MAT_ID) {
+        return NULL;
+    }
+    struct ggml_tensor * w = node->src[0];
+    if (w == NULL || w->view_src != NULL || w->buffer == NULL) {
+        return NULL;
+    }
+    if (ggml_backend_buffer_get_usage(w->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS || !ggml_backend_buffer_is_host(w->buffer)) {
+        return NULL;
+    }
+    if (w->ne[2] <= 1 || w->ne[3] != 1 || !ggml_is_contiguous(w)) {
+        return NULL;
+    }
+    return w;
+}
+
+// device backend that will execute cached MUL_MAT_ID nodes: highest priority non-CPU backend that supports the op
+static int ggml_backend_sched_expert_cache_backend(ggml_backend_sched_t sched, const struct ggml_tensor * node) {
+    for (int b = 0; b < sched->n_backends - 1; b++) {
+        if (ggml_backend_supports_op(sched->backends[b], node)) {
+            return b;
+        }
+    }
+    return -1;
+}
+
+static void ggml_backend_sched_expert_cache_free_buffers(struct ggml_backend_sched_expert_cache * cache) {
+    for (auto & it : cache->tensors) {
+        ggml_backend_buffer_free(it.second.buffer);
+        it.second.buffer = nullptr;
+    }
+}
+
+// (re)allocate the slot buffers for all registered tensors; called at the start of split_graph when the set of
+// cached tensors or the ids capacity changed
+static void ggml_backend_sched_expert_cache_layout(ggml_backend_sched_t sched) {
+    struct ggml_backend_sched_expert_cache * cache = sched->expert_cache;
+    if (!cache->layout_dirty) {
+        return;
+    }
+    cache->layout_dirty = false;
+
+    // all backends must be idle: the previous graph may still be reading the old slot buffers
+    for (int i = 0; i < sched->n_backends; i++) {
+        ggml_backend_synchronize(sched->backends[i]);
+    }
+    ggml_backend_sched_expert_cache_free_buffers(cache);
+
+    size_t sum_expert_size = 0;
+    for (const auto & it : cache->tensors) {
+        sum_expert_size += it.second.expert_size;
+    }
+    if (sum_expert_size == 0) {
+        return;
+    }
+
+    const int n_slots_min = cache->params.n_slots_min > 0 ? cache->params.n_slots_min : 8;
+    const int64_t n_slots_budget = std::max<int64_t>(n_slots_min, (int64_t) (cache->params.capacity_bytes / sum_expert_size));
+
+    cache->stats.n_tensors        = 0;
+    cache->stats.n_slots_total    = 0;
+    cache->stats.slot_bytes_total = 0;
+
+    for (auto & it : cache->tensors) {
+        ggml_backend_sched_expert_tensor & et = it.second;
+        et.n_slots = (int) std::min<int64_t>(n_slots_budget, et.n_expert);
+        et.slots_nbytes = (size_t) et.n_slots * et.expert_size;
+        // extra room: MMQ reads past the last expert and some backends report alloc_size > nbytes
+        et.ids_offset = et.slots_nbytes + std::max<size_t>(GGML_SCHED_EXPERT_CACHE_PAD, 1 << 20);
+        et.ids_nbytes = std::max(et.ids_nbytes, (size_t) 256);
+        const size_t total = et.ids_offset + et.ids_nbytes + GGML_SCHED_EXPERT_CACHE_PAD;
+
+        et.buffer = ggml_backend_buft_alloc_buffer(sched->bufts[et.backend_id], total);
+        if (et.buffer == NULL) {
+            GGML_ABORT("%s: failed to allocate %zu bytes of expert cache slots for %s on %s\n", __func__, total, et.weight->name,
+                ggml_backend_buft_name(sched->bufts[et.backend_id]));
+        }
+        ggml_backend_buffer_set_usage(et.buffer, GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+        ggml_backend_buffer_clear(et.buffer, 0); // padding must never contain NaN patterns
+
+        et.slot_of_expert.assign(et.n_expert, -1);
+        et.expert_of_slot.assign(et.n_slots, -1);
+        et.last_use.assign(et.n_slots, 0);
+        et.use_count.assign(et.n_slots, 0);
+        et.tick = 0;
+
+        cache->stats.n_tensors++;
+        cache->stats.n_slots_total    += et.n_slots;
+        cache->stats.slot_bytes_total += total;
+    }
+
+    GGML_LOG_INFO("%s: expert cache: %zu tensors, %d slots/tensor (budget %zu MiB, %.2f MiB per expert), %.2f MiB on device\n", __func__,
+        cache->tensors.size(), (int) std::min<int64_t>(n_slots_budget, INT32_MAX), cache->params.capacity_bytes / 1024 / 1024,
+        sum_expert_size / (double) cache->tensors.size() / 1024.0 / 1024.0, cache->stats.slot_bytes_total / 1024.0 / 1024.0);
+}
+
+// pass 0 of split_graph: discover host expert weights consumed by MUL_MAT_ID and make sure slot buffers exist
+static void ggml_backend_sched_expert_cache_prepare(ggml_backend_sched_t sched, struct ggml_cgraph * graph) {
+    struct ggml_backend_sched_expert_cache * cache = sched->expert_cache;
+    for (auto & it : cache->tensors) {
+        it.second.slots_view = nullptr;
+        it.second.ids_remap  = nullptr;
+        it.second.ids_orig   = nullptr;
+    }
+    for (int i = 0; i < graph->n_nodes; i++) {
+        struct ggml_tensor * node = graph->nodes[i];
+        struct ggml_tensor * w = ggml_backend_sched_expert_cache_weight(sched, node);
+        if (w == NULL) {
+            continue;
+        }
+        const int backend_id = ggml_backend_sched_expert_cache_backend(sched, node);
+        if (backend_id < 0) {
+            continue; // no device backend supports this op, the CPU path will be used
+        }
+        const size_t ids_nbytes = ggml_nbytes(node->src[2]);
+        auto it = cache->tensors.find(w);
+        if (it == cache->tensors.end()) {
+            ggml_backend_sched_expert_tensor et;
+            et.weight      = w;
+            et.backend_id  = backend_id;
+            et.n_expert    = w->ne[2];
+            et.expert_size = w->nb[2];
+            et.ids_nbytes  = ids_nbytes;
+            cache->tensors.emplace(w, std::move(et));
+            cache->layout_dirty = true;
+        } else if (it->second.ids_nbytes < ids_nbytes) {
+            it->second.ids_nbytes = ids_nbytes;
+            cache->layout_dirty = true;
+        }
+    }
+    ggml_backend_sched_expert_cache_layout(sched);
+}
+
+// pass 5 of split_graph: create the per-graph slot view and ids remap tensors for a cached node
+static struct ggml_tensor * ggml_backend_sched_expert_cache_slots_view(ggml_backend_sched_t sched, ggml_backend_sched_expert_tensor & et) {
+    if (et.slots_view == nullptr) {
+        struct ggml_tensor * w = et.weight;
+        struct ggml_tensor * t = ggml_new_tensor_3d(sched->ctx, w->type, w->ne[0], w->ne[1], et.n_slots);
+        ggml_format_name(t, "%s#xcache", w->name);
+        if (ggml_backend_tensor_alloc(et.buffer, t, ggml_backend_buffer_get_base(et.buffer)) != GGML_STATUS_SUCCESS) {
+            GGML_ABORT("%s: failed to bind expert cache slots for %s\n", __func__, w->name);
+        }
+        et.slots_view = t;
+    }
+    return et.slots_view;
+}
+
+static void ggml_backend_sched_expert_cache_bind_ids(ggml_backend_sched_t sched, struct ggml_tensor * node, ggml_backend_sched_expert_tensor & et, struct ggml_tensor * ids) {
+    if (et.ids_remap != nullptr) {
+        // a weight is expected to be consumed by exactly one MUL_MAT_ID per graph
+        GGML_ASSERT(et.ids_orig == ids && "expert cache: weight used by multiple MUL_MAT_ID nodes with different ids");
+        node->src[2] = et.ids_remap;
+        return;
+    }
+    GGML_ASSERT(ggml_nbytes(ids) <= et.ids_nbytes);
+    struct ggml_tensor * remap = ggml_dup_tensor_layout(sched->ctx, ids);
+    ggml_format_name(remap, "%s#xids", et.weight->name);
+    if (ggml_backend_tensor_alloc(et.buffer, remap, (char *) ggml_backend_buffer_get_base(et.buffer) + et.ids_offset) != GGML_STATUS_SUCCESS) {
+        GGML_ABORT("%s: failed to bind expert cache ids for %s\n", __func__, et.weight->name);
+    }
+    et.ids_remap = remap;
+    et.ids_orig  = ids;
+    node->src[2] = remap;
+}
+
+// compute time: make the experts selected by `ids` resident in the slots and upload the remapped ids
+static enum ggml_status ggml_backend_sched_expert_cache_load(
+        ggml_backend_sched_t sched, ggml_backend_sched_expert_tensor & et, ggml_backend_t split_backend,
+        struct ggml_tensor ** prev_ids_tensor) {
+    struct ggml_backend_sched_expert_cache * cache = sched->expert_cache;
+    struct ggml_tensor * ids = et.ids_orig;
+    GGML_ASSERT(ids != nullptr && et.slots_view != nullptr && et.ids_remap != nullptr);
+
+    const int64_t t_start = ggml_time_us();
+
+    // download the logical ids (they are produced by a previous split on the device)
+    if (ids != *prev_ids_tensor) {
+        ggml_backend_t ids_backend = ggml_backend_sched_get_tensor_backend(sched, ids);
+        if (ids_backend == NULL) {
+            ids_backend = split_backend;
+        }
+        cache->ids_host.resize(ggml_nbytes(ids) / sizeof(int32_t));
+        ggml_backend_tensor_get_async(ids_backend, ids, cache->ids_host.data(), 0, ggml_nbytes(ids));
+        ggml_backend_synchronize(ids_backend);
+        *prev_ids_tensor = ids;
+    }
+
+    const int64_t n_expert = et.n_expert;
+    et.tick++;
+
+    // distinct experts required by this step
+    cache->used.assign(n_expert, 0);
+    int64_t n_used = 0;
+    for (int64_t i1 = 0; i1 < ids->ne[1]; i1++) {
+        for (int64_t i0 = 0; i0 < ids->ne[0]; i0++) {
+            const int32_t id = cache->ids_host[i1 * ids->nb[1]/sizeof(int32_t) + i0 * ids->nb[0]/sizeof(int32_t)];
+            GGML_ASSERT(id >= 0 && id < n_expert);
+            if (!cache->used[id]) {
+                cache->used[id] = 1;
+                n_used++;
+            }
+        }
+    }
+    if (n_used > et.n_slots) {
+        GGML_LOG_ERROR("%s: expert cache: %s requires %lld distinct experts but only %d slots are available; "
+            "increase the cache size or reduce the batch size (-ub)\n", __func__, et.weight->name, (long long) n_used, et.n_slots);
+        return GGML_STATUS_FAILED;
+    }
+
+    // hits: touch resident experts first so that they cannot be chosen as victims
+    int64_t n_hits = 0;
+    for (int64_t e = 0; e < n_expert; e++) {
+        if (!cache->used[e]) {
+            continue;
+        }
+        const int32_t s = et.slot_of_expert[e];
+        if (s >= 0) {
+            et.last_use[s] = et.tick;
+            et.use_count[s]++;
+            n_hits++;
+        }
+    }
+
+    // misses: choose a victim slot per policy and copy the expert
+    const uint8_t * src_base = (const uint8_t *) et.weight->data;
+    int64_t n_miss = 0;
+    int64_t n_evict = 0;
+    int next_scan = 0; // empty-slot scan cursor
+    for (int64_t e = 0; e < n_expert; e++) {
+        if (!cache->used[e] || et.slot_of_expert[e] >= 0) {
+            continue;
+        }
+        int victim = -1;
+        // prefer empty slots
+        for (; next_scan < et.n_slots; next_scan++) {
+            if (et.expert_of_slot[next_scan] < 0) {
+                victim = next_scan++;
+                break;
+            }
+        }
+        if (victim < 0) {
+            for (int s = 0; s < et.n_slots; s++) {
+                if (et.last_use[s] == et.tick) {
+                    continue; // needed by this step
+                }
+                if (victim < 0) {
+                    victim = s;
+                    continue;
+                }
+                bool better;
+                if (cache->params.policy == GGML_SCHED_EXPERT_CACHE_LFU) {
+                    better = et.use_count[s] < et.use_count[victim] ||
+                             (et.use_count[s] == et.use_count[victim] && et.last_use[s] < et.last_use[victim]);
+                } else {
+                    better = et.last_use[s] < et.last_use[victim];
+                }
+                if (better) {
+                    victim = s;
+                }
+            }
+            GGML_ASSERT(victim >= 0);
+            const int32_t old = et.expert_of_slot[victim];
+            if (old >= 0) {
