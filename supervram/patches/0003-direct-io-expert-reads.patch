+// direct I/O: open an O_DIRECT fd for every cached weight that has a registered file source
+static void ggml_backend_sched_expert_cache_resolve_sources(struct ggml_backend_sched_expert_cache * cache) {
+#if defined(__linux__)
+    if (!cache->direct_io) {
+        return;
+    }
+    for (auto & it : cache->tensors) {
+        ggml_backend_sched_expert_tensor & et = it.second;
+        if (et.src_fd >= 0) {
+            continue;
+        }
+        ggml_expert_source src;
+        {
+            std::lock_guard<std::mutex> lock(g_expert_sources_mutex);
+            auto s = g_expert_sources.find(et.weight);
+            if (s == g_expert_sources.end()) {
+                GGML_LOG_WARN("%s: expert cache: no file source registered for %s, reading it through the mmap\n", __func__, et.weight->name);
+                continue;
+            }
+            src = s->second;
+        }
+        auto f = cache->fds.find(src.path);
+        if (f == cache->fds.end()) {
+            const int fd = open(src.path.c_str(), O_RDONLY | O_DIRECT);
+            if (fd < 0) {
+                GGML_LOG_WARN("%s: expert cache: cannot open %s with O_DIRECT, using the mmap\n", __func__, src.path.c_str());
+            }
+            f = cache->fds.emplace(src.path, fd).first;
+        }
+        if (f->second >= 0) {
+            et.src_fd     = f->second;
+            et.src_offset = src.offset;
+        }
+    }
+#else
+    GGML_UNUSED(cache);
+#endif
