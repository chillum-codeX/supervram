+struct ggml_expert_io_pool {
+    std::vector<std::thread> threads;
+    std::mutex               m;
+    std::condition_variable  cv_work;
+    std::condition_variable  cv_done;
+    std::vector<ggml_expert_io_job> queue;
+    size_t                   next    = 0;
+    size_t                   pending = 0;
+    bool                     stop    = false;
+    std::atomic<int>         failed{0};
+
+    explicit ggml_expert_io_pool(int n_threads) {
+        for (int i = 0; i < n_threads; i++) {
+            threads.emplace_back([this] { loop(); });
+        }
+    }
+    ~ggml_expert_io_pool() {
+        {
+            std::lock_guard<std::mutex> lock(m);
+            stop = true;
+        }
+        cv_work.notify_all();
+        for (auto & t : threads) {
+            t.join();
+        }
+    }
+    static bool read_full(const ggml_expert_io_job & j) {
+        size_t done = 0;
+        while (done < j.len) {
+            const ssize_t n = pread(j.fd, j.dst + done, j.len - done, (off_t) (j.offset + done));
+            if (n <= 0) {
+                break;
+            }
+            done += (size_t) n;
+        }
+        return done >= j.need;
+    }
+    void loop() {
+        for (;;) {
+            ggml_expert_io_job job;
+            {
+                std::unique_lock<std::mutex> lock(m);
+                cv_work.wait(lock, [this] { return stop || next < queue.size(); });
+                if (stop) {
+                    return;
+                }
+                job = queue[next++];
+            }
+            if (!read_full(job)) {
+                failed = 1;
+            }
+            {
+                std::lock_guard<std::mutex> lock(m);
+                if (--pending == 0) {
+                    cv_done.notify_all();
+                }
+            }
+        }
+    }
+    // blocks until all jobs are done; returns false if any read failed
+    bool run(std::vector<ggml_expert_io_job> && jobs) {
+        std::unique_lock<std::mutex> lock(m);
+        failed  = 0;
+        queue   = std::move(jobs);
+        next    = 0;
+        pending = queue.size();
+        cv_work.notify_all();
+        cv_done.wait(lock, [this] { return pending == 0; });
+        return failed == 0;
+    }
