+// direct I/O: read the missed experts with parallel O_DIRECT reads into the pinned staging buffer, then copy each
+// one into its device slot. Reads are 4 KiB aligned (a few KiB of padding per expert); the copy skips the padding.
+static bool ggml_backend_sched_expert_cache_read_direct(
+        struct ggml_backend_sched_expert_cache * cache, ggml_backend_sched_expert_tensor & et,
+        ggml_backend_t split_backend, const std::vector<ggml_expert_miss> & misses) {
+#if defined(__linux__)
+    const size_t align  = 4096;
+    const size_t stride = ((et.expert_size + align - 1) & ~(align - 1)) + align; // room for head/tail padding
+
+    if (cache->staging == nullptr) {
+        const size_t bytes = std::max(cache->staging_bytes, stride);
+        uint8_t * raw = nullptr;
+        ggml_backend_dev_t dev = ggml_backend_get_device(split_backend);
+        ggml_backend_buffer_type_t buft = dev ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+        if (buft != nullptr) {
+            cache->staging_buf = ggml_backend_buft_alloc_buffer(buft, bytes + align);
+            if (cache->staging_buf != nullptr) {
+                raw = (uint8_t *) ggml_backend_buffer_get_base(cache->staging_buf);
+            }
+        }
+        if (raw == nullptr) {
+            GGML_LOG_WARN("%s: expert cache: no pinned host buffer available, staging in pageable memory\n", __func__);
+            if (posix_memalign(&cache->staging_heap, align, bytes + align) != 0) {
+                return false;
+            }
+            raw = (uint8_t *) cache->staging_heap;
+        }
+        cache->staging       = (uint8_t *) (((uintptr_t) raw + align - 1) & ~(uintptr_t) (align - 1));
+        cache->staging_bytes = bytes;
+        GGML_LOG_INFO("%s: expert cache: direct I/O, %d threads, %zu MiB %s staging\n", __func__,
+            cache->io_threads, bytes / 1024 / 1024, cache->staging_buf ? "pinned" : "pageable");
+    }
+    if (cache->pool == nullptr) {
+        cache->pool = new ggml_expert_io_pool(cache->io_threads);
+    }
+
+    const size_t n_stage = std::max<size_t>(1, cache->staging_bytes / stride);
+    for (size_t i0 = 0; i0 < misses.size(); i0 += n_stage) {
+        const size_t n = std::min(n_stage, misses.size() - i0);
+
+        // the previous async copies may still be reading the staging buffer
+        if (cache->staging_busy) {
+            ggml_backend_synchronize(split_backend);
+            cache->staging_busy = false;
+        }
+
+        std::vector<ggml_expert_io_job> jobs;
+        std::vector<size_t> head(n);
+        jobs.reserve(n);
+        for (size_t k = 0; k < n; k++) {
+            const uint64_t off = et.src_offset + (uint64_t) misses[i0 + k].expert * et.expert_size;
+            const uint64_t a   = off & ~(uint64_t) (align - 1);
+            const uint64_t end = (off + et.expert_size + align - 1) & ~(uint64_t) (align - 1);
+            head[k] = (size_t) (off - a);
+            jobs.push_back({ et.src_fd, cache->staging + k * stride, a, (size_t) (end - a), head[k] + et.expert_size });
+            cache->stats.bytes_ssd += end - a;
+        }
+
+        const int64_t t_io = ggml_time_us();
+        if (!cache->pool->run(std::move(jobs))) {
+            GGML_LOG_ERROR("%s: expert cache: direct read failed for %s\n", __func__, et.weight->name);
+            return false;
+        }
+        cache->stats.io_ms += (ggml_time_us() - t_io) / 1000.0;
+
+        for (size_t k = 0; k < n; k++) {
+            ggml_backend_tensor_set_async(split_backend, et.slots_view,
+                cache->staging + k * stride + head[k], (size_t) misses[i0 + k].slot * et.expert_size, et.expert_size);
+        }
+        cache->staging_busy = true;
+    }
+    return true;
+#else
+    GGML_UNUSED(cache); GGML_UNUSED(et); GGML_UNUSED(split_backend); GGML_UNUSED(misses);
+    return false;
+#endif
+}
