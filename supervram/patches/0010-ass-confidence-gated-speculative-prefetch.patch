+// Main-thread only (called from plan(), after this step's real hit/miss resolution): decide
+// what to speculatively prefetch for this tensor's NEXT visit (one token from now) and submit
+// those reads to the background worker. See the module-top comment and
+// docs/ASS_CPP_PORT_PROGRESS.md for why this predicts same-layer/next-token reuse rather than a
+// genuine multi-layer lookahead (not physically available for batch=1 autoregressive decode).
+static void ggml_backend_sched_expert_cache_spec_generate(struct ggml_backend_sched_expert_cache * cache, ggml_backend_sched_expert_tensor & et) {
+#if defined(__linux__)
+    if (et.layer < 0 || et.kind < 0 || et.src_fd < 0) {
+        return; // needs both a parsed (layer,kind) identity and a direct-io source
+    }
+    ggml_backend_sched_expert_cache_spec_ensure(cache);
+    const int32_t gate_layer = et.layer * 3 + et.kind; // keeps gate/up/down confidence independent, see struct comment
+
+    // 1. decay the per-expert recency score, bump whatever this step actually used (cache->used
+    //    was just populated by the hit/miss resolution this function runs after).
+    const float decay = 0.9f;
+    std::vector<int32_t> chosen;
+    for (int64_t e = 0; e < et.n_expert; e++) {
+        if (cache->used[e]) {
+            et.spec_score[e] = et.spec_score[e] * decay + 1.0f;
+            chosen.push_back((int32_t) e);
+        } else {
+            et.spec_score[e] *= decay;
+        }
+    }
+
+    // 2. resolve whatever was predicted last visit against this visit's real outcome.
+    cache->spec_gate->observe(gate_layer, chosen);
+
+    // 3. candidates for the NEXT visit: highest spec_score among not-currently-resident experts.
+    const int top_k = cache->spec_gate->config().top_k;
+    std::vector<int32_t> ranked;
+    ranked.reserve((size_t) et.n_expert);
+    for (int64_t e = 0; e < et.n_expert; e++) {
+        if (et.slot_of_expert[e] < 0 && et.spec_score[e] > 0.0f) {
+            ranked.push_back((int32_t) e);
+        }
+    }
+    std::stable_sort(ranked.begin(), ranked.end(), [&et](int32_t a, int32_t b) { return et.spec_score[a] > et.spec_score[b]; });
+    if ((int) ranked.size() > top_k) {
+        ranked.resize((size_t) top_k);
+    }
+    cache->spec_gate->set_pending(gate_layer, ranked);
+    if (ranked.empty()) {
+        return;
+    }
+
+    // 4. gate: which of those candidates actually earn a speculative read against the shared budget.
+    std::vector<svram::SpeculativeCandidate> pool;
+    pool.reserve(ranked.size());
+    const double t_read = cache->spec_drive_bytes_per_sec > 0 ? (double) et.expert_size / cache->spec_drive_bytes_per_sec : 0.0;
+    for (int32_t e : ranked) {
+        pool.push_back({ gate_layer, e, t_read });
+    }
+    const auto decisions = cache->spec_gate->plan_window(pool, /*window_steps=*/top_k);
+
+    // 5. issue: prefer a genuinely empty slot; once the cache is warm (the common case -- an
+    //    empty-slots-only policy would leave this permanently inert once the cache fills, which
+    //    is exactly what an earlier version of this function did and was verified empirically to
+    //    never fire past the first couple of steps) fall back to evicting a slot NOT touched this
+    //    tick, using the exact same LRU/LFU comparison the required-miss path already trusts
+    //    (ggml_backend_sched_expert_cache_plan's own eviction loop above). This can still turn
+    //    out to be a mistake if the evicted expert is needed again soon -- that shows up as an
+    //    ordinary extra miss in the required path's own stats, not a correctness bug (re-verified
+    //    at commit time regardless, see spec_commit). `claimed` prevents two decisions in this
+    //    same call from picking the same victim slot.
+    const size_t align = 4096;
+    std::vector<bool> claimed(et.n_slots, false);
+    for (const auto & d : decisions) {
+        if (!d.fire) {
+            continue;
+        }
+        int victim = -1;
+        for (int s = 0; s < et.n_slots; s++) {
+            if (!claimed[s] && et.expert_of_slot[s] < 0) {
+                victim = s;
+                break;
+            }
+        }
+        if (victim < 0) {
+            for (int s = 0; s < et.n_slots; s++) {
+                if (claimed[s] || et.last_use[s] == et.tick) {
+                    continue; // already spoken for this call, or genuinely needed this step
+                }
+                if (victim < 0) {
+                    victim = s;
+                    continue;
+                }
+                const bool better = cache->params.policy == GGML_SCHED_EXPERT_CACHE_LFU
+                    ? (et.use_count[s] < et.use_count[victim] || (et.use_count[s] == et.use_count[victim] && et.last_use[s] < et.last_use[victim]))
+                    : (et.last_use[s] < et.last_use[victim]);
+                if (better) {
+                    victim = s;
+                }
+            }
+        }
+        if (victim < 0) {
+            break; // every slot is needed by this exact step; nothing safe to use
+        }
+        claimed[victim] = true;
+        const uint64_t off = et.src_offset + (uint64_t) d.key.expert * et.expert_size;
+        const uint64_t a   = off & ~(uint64_t) (align - 1);
+        const uint64_t end = (off + et.expert_size + align - 1) & ~(uint64_t) (align - 1);
+        auto * job = new ggml_backend_sched_expert_cache::ggml_spec_job();
+        job->et             = &et;
+        job->expert         = d.key.expert;
+        job->victim         = victim;
+        job->evicted_expert = et.expert_of_slot[victim];
+        job->evicted_last_use = et.last_use[victim];
+        job->offset_aligned = a;
+        job->staging_len    = (size_t) (end - a);
+        job->head            = (size_t) (off - a);
+        job->need            = job->head + et.expert_size;
+        if (posix_memalign((void **) &job->staging, align, job->staging_len) != 0) {
+            delete job;
+            continue;
+        }
+        {
+            std::lock_guard<std::mutex> lock(cache->spec_mtx);
+            cache->spec_queue.push_back(job);
+        }
+        cache->spec_cv.notify_one();
+        cache->stats.spec_issued++;
+    }
+#else
+    GGML_UNUSED(cache); GGML_UNUSED(et);
+#endif
+}
