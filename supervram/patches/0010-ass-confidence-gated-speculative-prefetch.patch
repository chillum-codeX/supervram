+// ---- ASS: SpeculativeGate (svram::SpeculativeGate, ggml-backend-expert-scheduler.h) ----
+//
+// Phase 2 of the ASS port (see docs/SPEC plan / writer_handoff/EVIDENCE_LEDGER.md "ASS"
+// sections): the confidence-gate logic in isolation, no ggml_backend_sched involved. Reference
+// values below were generated by running the actual Python implementation
+// (supervram/predictors.py::ConfidencePredictor, supervram/scheduler.py::plan_window) on the
+// identical input sequence -- not hand-derived -- specifically because a first hand-derivation
+// attempt here caught a real bug (float vs double precision: two confidence values that are
+// conceptually both "2/3" land on different doubles depending on their EMA update path, and
+// that residual difference is what plan_window's p_use tie-break actually keys off in practice).
+
+// exact bit patterns of the Python reference's final confidence table (see hex() dump), so
+// these tests catch a precision regression (e.g. float used instead of double), not just a
+// "close enough" logic bug.
+void test_gate_confidence_matches_python_reference() {
+    svram::SpeculativeGate gate;
+
+    // mirrors AdaptiveSpeculativeScheduler.record_and_observe's rhythm: observe() against
+    // whatever was pending, THEN set_pending() for the next visit.
+    const struct { std::vector<int32_t> candidates; std::vector<int32_t> chosen; } steps[] = {
+        { {1, 2, 3}, {1, 2} },
+        { {1, 2, 4}, {1, 4} },
+        { {1, 2, 4}, {1, 2, 4} },
+        { {1, 2, 4}, {2} },
+    };
+    for (const auto & step : steps) {
+        gate.observe(/*layer=*/0, step.chosen);
+        gate.set_pending(/*layer=*/0, step.candidates);
+    }
+
+    const double expected[5] = { 0.0, 0.6666666666666666, 0.6666666666666667, 0.0, 0.5 }; // index 1..4
+    for (int32_t e = 1; e <= 4; e++) {
+        const double actual = gate.confidence_of(0, e);
+        if (actual != expected[e]) {
+            fprintf(stderr, "expert=%d: expected=%.17g actual=%.17g (bit-exact mismatch vs Python reference)\n",
+                    e, expected[e], actual);
+            GGML_ABORT("SpeculativeGate confidence diverged from the Python reference");
+        }
+    }
+    // expert 3 was only ever a candidate once (step 1) and missed -> single observation, hit=0,
+    // effective_alpha = min(alpha, 0/1) = 0, so confidence = 0*default + 1*0 = 0.0 exactly.
+    GGML_ASSERT(gate.confidence_of(0, 3) == 0.0);
+    // never-seen expert must return the neutral default, not 0 or some other fallback.
+    GGML_ASSERT(gate.confidence_of(0, 99) == 0.5);
+}
+
+// Reproduces the exact fire/no-fire pattern computed by the real
+// AdaptiveSpeculativeScheduler.plan_window on the same confidence table + a fixed candidate
+// pool, including the floating-point-noise-driven tie-break order documented above (Python:
+// expert=2 sorts before expert=1 among p_use~=0.6667 ties, NOT the "larger t_read first" the
+// plan-window docstring's stated tie-break rule alone would suggest -- confirmed against the
+// real Python run, not assumed).
+void test_gate_plan_window_matches_python_reference() {
+    const struct { std::vector<int32_t> candidates; std::vector<int32_t> chosen; } steps[] = {
+        { {1, 2, 3}, {1, 2} },
+        { {1, 2, 4}, {1, 4} },
+        { {1, 2, 4}, {1, 2, 4} },
+        { {1, 2, 4}, {2} },
+    };
+    // sizes chosen to deliberately vary t_read across experts (bytes / (2.4 GB/s)):
+    // expert1: 300MB->0.125s, expert2: 150MB->0.0625s, expert3: 900MB->0.375s, expert4: 150MB->0.0625s
+    const std::vector<svram::SpeculativeCandidate> pool = {
+        {0, 1, 0.125}, {0, 2, 0.0625}, {0, 3, 0.375}, {0, 4, 0.0625},
+        {0, 1, 0.125}, {0, 2, 0.0625}, {0, 3, 0.375}, {0, 4, 0.0625},
+    };
+    svram::SpeculativeGateConfig cfg;
+    cfg.compute_ms_per_layer = 0.19;
+    cfg.gate_threshold = 0.3;
+    cfg.top_k = 4;
+    svram::SpeculativeGate gate2(cfg);
+    // re-run the same observe/set_pending trace on gate2 (fresh instance with the target config)
+    for (const auto & step : steps) {
+        gate2.observe(0, step.chosen);
+        gate2.set_pending(0, step.candidates);
+    }
+
+    const auto decisions = gate2.plan_window(pool, /*window_steps=*/2);
+    // budget_seconds = 0.19/1000 * 2 = 0.00038; top_k=4 keeps only the highest-(p_use,t_read)
+    // 4 of the 8 pooled entries -- per the Python reference run, that is expert=2 (x2) then
+    // expert=1 (x2), all of which fail the budget (0.0625s and 0.125s both exceed 0.00038s).
+    GGML_ASSERT(decisions.size() == 4);
+    const int32_t expected_order[4] = { 2, 2, 1, 1 };
+    for (size_t i = 0; i < decisions.size(); i++) {
+        if (decisions[i].key.expert != expected_order[i]) {
+            fprintf(stderr, "position %zu: expected expert=%d actual expert=%d\n", i, expected_order[i], decisions[i].key.expert);
+            GGML_ABORT("SpeculativeGate::plan_window pool order diverged from the Python reference");
+        }
+        GGML_ASSERT(decisions[i].fire == false); // every candidate's t_read exceeds the tiny 2-step budget
+    }
+}
+
+// A candidate whose confidence clears the gate_threshold AND whose read fits the remaining
+// budget must fire; once the budget is spent, a later (lower-priority) candidate that would
+// still individually fit is correctly refused if an earlier, higher-confidence candidate
+// already consumed the budget it needed -- this is the actual point of "budget-pooled" (a
+// per-candidate-independent gate would fire both).
+void test_gate_budget_is_shared_not_per_candidate() {
+    svram::SpeculativeGateConfig cfg;
+    cfg.compute_ms_per_layer = 100.0; // generous budget in ms so the numbers are easy to reason about
+    cfg.gate_threshold = 0.3;
+    cfg.top_k = 8;
+    svram::SpeculativeGate gate(cfg);
+    gate.observe(0, {});               // no-op, nothing pending yet
+    gate.set_pending(0, {1, 2});
+    gate.observe(0, {1, 2});           // both hit -> confidence(1)=confidence(2)=1.0 after 1 observation
+
+    // budget_seconds = 100/1000 * 1 = 0.1s. Two candidates at 0.06s each: the first fits, the
+    // second does not (0.06 + 0.06 = 0.12 > 0.1), even though each individually is well under
+    // the total budget and both have maximal confidence.
+    const std::vector<svram::SpeculativeCandidate> pool = { {0, 1, 0.06}, {0, 2, 0.06} };
+    const auto decisions = gate.plan_window(pool, /*window_steps=*/1);
+    GGML_ASSERT(decisions.size() == 2);
+    GGML_ASSERT(decisions[0].fire == true);
+    GGML_ASSERT(decisions[1].fire == false);
+}
+
+// A second observe() for the same layer without an intervening set_pending() must be a no-op
+// (matches Python's dict.pop(..., None) semantics) -- confirms the pending-set consumption
+// behavior, not just the EMA math.
+void test_gate_observe_without_pending_is_noop() {
+    svram::SpeculativeGate gate;
+    gate.set_pending(0, {5});
+    gate.observe(0, {5}); // consumes the pending set: confidence(0,5) becomes 1.0
+    GGML_ASSERT(gate.confidence_of(0, 5) == 1.0);
+    gate.observe(0, {});  // nothing pending anymore -> must not touch confidence(0,5)
+    GGML_ASSERT(gate.confidence_of(0, 5) == 1.0);
+}
+
