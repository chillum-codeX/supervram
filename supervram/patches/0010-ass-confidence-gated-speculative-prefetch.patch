+// ASS: confidence-gated speculative prefetch, classic/direct-io tier only. See
+// docs/ASS_CPP_PORT_PROGRESS.md for the design and svram::SpeculativeGate (ggml-backend-expert-scheduler.h)
+// for the ported confidence-gate math. Everything below only runs when cache->scheduler ==
+// GGML_SCHED_EXPERT_SCHEDULER_ASS and cache->direct_io; it is inert (zero cost, zero behavior
+// change) otherwise.
+
+// background worker: pulls a job off spec_queue, reads its bytes with a plain blocking pread()
+// (reusing ggml_expert_io_pool::read_full so the O_DIRECT read path isn't duplicated), pushes the
+// completed job to spec_done. Never touches cache bookkeeping -- see the struct's own comment.
+static void ggml_backend_sched_expert_cache_spec_worker_loop(struct ggml_backend_sched_expert_cache * cache) {
+#if defined(__linux__)
+    for (;;) {
+        ggml_backend_sched_expert_cache::ggml_spec_job * job = nullptr;
+        {
+            std::unique_lock<std::mutex> lock(cache->spec_mtx);
+            cache->spec_cv.wait(lock, [cache] { return cache->spec_stop || !cache->spec_queue.empty(); });
+            if (cache->spec_stop) {
+                return;
+            }
+            job = cache->spec_queue.back();
+            cache->spec_queue.pop_back();
+        }
+        job->ok = ggml_expert_io_pool::read_full({ job->et->src_fd, job->staging, job->offset_aligned, job->staging_len, job->need });
+        {
+            std::lock_guard<std::mutex> lock(cache->spec_mtx);
+            cache->spec_done.push_back(job);
+        }
+    }
+#else
+    GGML_UNUSED(cache);
+#endif
+}
+
+static void ggml_backend_sched_expert_cache_spec_ensure(struct ggml_backend_sched_expert_cache * cache) {
+    if (cache->spec_gate == nullptr) {
+        svram::SpeculativeGateConfig cfg; // defaults match the validated Python simulation's own defaults
+        cache->spec_gate = new svram::SpeculativeGate(cfg);
+        if (const char * env = getenv("SVRAM_SPEC_DRIVE_GBPS")) {
+            const double gbps = atof(env);
+            if (gbps > 0) {
+                cache->spec_drive_bytes_per_sec = gbps * 1e9;
+            }
+        }
+    }
+#if defined(__linux__)
+    if (!cache->spec_worker.joinable()) {
+        cache->spec_worker = std::thread([cache] { ggml_backend_sched_expert_cache_spec_worker_loop(cache); });
+    }
+#endif
+}
