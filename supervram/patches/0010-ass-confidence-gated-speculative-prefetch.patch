+    run("test_gate_confidence_matches_python_reference", test_gate_confidence_matches_python_reference);
+    run("test_gate_plan_window_matches_python_reference", test_gate_plan_window_matches_python_reference);
+    run("test_gate_budget_is_shared_not_per_candidate", test_gate_budget_is_shared_not_per_candidate);
+    run("test_gate_observe_without_pending_is_noop", test_gate_observe_without_pending_is_noop);
