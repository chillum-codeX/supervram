 }
diff --git a/ggml/src/ggml-backend-expert-scheduler.h b/ggml/src/ggml-backend-expert-scheduler.h
new file mode 100644
index 0000000..6ad78e0
--- /dev/null
+++ b/ggml/src/ggml-backend-expert-scheduler.h
@@ -0,0 +1,153 @@
+// ASS: confidence-gated, budget-pooled speculative expert prefetch -- the "gate" decision logic
+// only, ported from the validated Python simulation (supervram/scheduler.py::AdaptiveSpeculativeScheduler,
+// supervram/predictors.py::ConfidencePredictor). See docs/SPEC pattern in
+// docs/PLAN_ADAPTIVE.md and writer_handoff/EVIDENCE_LEDGER.md's "ASS" sections for the design
+// history; note the code (not docs/PLAN_ADAPTIVE.md sections 2.1/4's pseudocode) is ground truth
+// -- the doc formula was tried and abandoned because it degenerates to ignoring confidence.
+//
+// This header has NO dependency on ggml/ggml-backend types by design (Phase 2 of the port): it
+// is pure, backend-agnostic logic, independently unit-testable against the Python reference
+// before being wired into the real classic/direct-io cache path (Phase 3).
+//
+// Candidate generation (deciding WHICH (layer,expert) pairs are worth asking the gate about, and
+// what their real I/O cost is) is deliberately NOT this class's job -- the caller supplies a pool
+// of candidates with a measured read cost; this class only calibrates confidence from observed
+// history and decides which candidates to fire against a shared time budget.
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <unordered_map>
+#include <vector>
+
+namespace svram {
+
+struct ExpertKey {
+    int32_t layer;
+    int32_t expert;
+
+    bool operator==(const ExpertKey & o) const { return layer == o.layer && expert == o.expert; }
+};
+
+struct ExpertKeyHash {
+    size_t operator()(const ExpertKey & k) const {
+        return std::hash<int64_t>()((((int64_t) k.layer) << 32) | (uint32_t) k.expert);
+    }
+};
+
+// one candidate the gate is asked to judge: which expert, and how long a real read would take
+struct SpeculativeCandidate {
+    int32_t layer;
+    int32_t expert;
+    double  t_read_seconds;
+};
+
+// the gate's verdict on one candidate
+struct ReadDecision {
+    ExpertKey key;
+    double    p_use;
+    double    t_read_seconds;
+    bool      fire;
+};
+
+struct SpeculativeGateConfig {
+    double compute_ms_per_layer = 0.19; // per-window-step compute time the budget is measured against (real value should be measured, not this default)
+    double gate_threshold       = 0.3;  // hard floor: p_use below this never fires regardless of budget
+    int    top_k                = 4;    // pool-wide cap on how many candidates are even considered, after sorting by (p_use, t_read) desc
+    double alpha                = 0.9;  // EMA smoothing factor once a (layer,expert) has enough observations
+    double default_confidence   = 0.5;  // neutral prior for a never-observed (layer,expert) -- NOT gated off by default
+};
+
+// Ports supervram/predictors.py::ConfidencePredictor (the EMA confidence table) and the
+// pooled-budget greedy-knapsack spend from supervram/scheduler.py::AdaptiveSpeculativeScheduler.plan_window.
+class SpeculativeGate {
+public:
+    explicit SpeculativeGate(SpeculativeGateConfig cfg = {}) : cfg_(cfg) {}
+
+    // Mirrors ConfidencePredictor.observe(access): resolves whatever candidate set was last
+    // `set_pending()` for this layer against the real outcome (`chosen`), updating the EMA
+    // confidence table. Bias-corrected EMA: effective_alpha ramps 0 -> cfg_.alpha as the
+    // observation count grows, exactly matching the Python reference (predictors.py).
+    //
+    // Matches Python's `self._pending.pop(access.layer, None)` exactly: the pending set is
+    // consumed (erased) here, not just read -- a second observe() for the same layer without an
+    // intervening set_pending() is a deliberate no-op, same as the Python reference.
+    //
+    // Precision note: confidence is stored as `double` (not `float`), matching Python's `float`
+    // (CPython doubles), not merely for parity's sake -- verified empirically that two
+    // confidence values which are conceptually equal (e.g. both "2/3") can reach that value via
+    // different EMA update paths and land on bit-different doubles; plan_window's tie-break on
+    // p_use then depends on that residual difference. Losing precision to `float` here would
+    // make that ordering (and therefore fire/no-fire decisions) diverge from the Python reference.
+    void observe(int32_t layer, const std::vector<int32_t> & chosen) {
+        auto it = pending_.find(layer);
+        if (it == pending_.end()) {
+            return; // nothing was predicted for this layer yet, nothing to resolve
+        }
+        std::vector<int32_t> candidates = std::move(it->second);
+        pending_.erase(it);
+        for (int32_t expert : candidates) {
+            const ExpertKey key{ layer, expert };
+            const bool hit = std::find(chosen.begin(), chosen.end(), expert) != chosen.end();
+            int & count = counts_[key];
+            count++;
+            const double effective_alpha = std::min(cfg_.alpha, (double) (count - 1) / (double) count);
+            double & conf = confidence_.try_emplace(key, cfg_.default_confidence).first->second;
+            conf = effective_alpha * conf + (1.0 - effective_alpha) * (hit ? 1.0 : 0.0);
+        }
+    }
+
+    // Mirrors ConfidencePredictor.set_pending(layer, candidates): stores the layer's next
+    // candidate set for the following observe() call to resolve against. Python stores this as
+    // a `set[int]` (deduplicated) -- mirrored here so a caller passing a duplicate expert id
+    // doesn't double-count that expert's EMA update on the next observe().
+    void set_pending(int32_t layer, std::vector<int32_t> candidates) {
+        std::sort(candidates.begin(), candidates.end());
+        candidates.erase(std::unique(candidates.begin(), candidates.end()), candidates.end());
+        pending_[layer] = std::move(candidates);
+    }
+
+    // Mirrors ConfidencePredictor.confidence_of(layer, expert): pure O(1) lookup, neutral
+    // default for anything never observed.
+    double confidence_of(int32_t layer, int32_t expert) const {
+        auto it = confidence_.find(ExpertKey{ layer, expert });
+        return it == confidence_.end() ? cfg_.default_confidence : it->second;
+    }
+
+    // Mirrors AdaptiveSpeculativeScheduler.plan_window's pooled greedy-knapsack: pool candidates
+    // across the whole window, sort by (p_use, t_read) descending, truncate to top_k, then
+    // greedily spend a SHARED time budget (compute_ms_per_layer/1000 * window_steps) in that
+    // order, gated by a hard confidence floor independent of budget.
+    std::vector<ReadDecision> plan_window(const std::vector<SpeculativeCandidate> & pool, int window_steps) const {
+        std::vector<ReadDecision> decisions;
+        decisions.reserve(pool.size());
+        for (const auto & c : pool) {
+            decisions.push_back({ ExpertKey{ c.layer, c.expert }, confidence_of(c.layer, c.expert), c.t_read_seconds, false });
+        }
+        std::stable_sort(decisions.begin(), decisions.end(), [](const ReadDecision & a, const ReadDecision & b) {
+            if (a.p_use != b.p_use) return a.p_use > b.p_use;
+            return a.t_read_seconds > b.t_read_seconds;
+        });
+        if ((int) decisions.size() > cfg_.top_k) {
+            decisions.resize((size_t) cfg_.top_k);
+        }
+        double remaining_budget = cfg_.compute_ms_per_layer / 1000.0 * window_steps;
+        for (auto & d : decisions) {
+            d.fire = d.p_use >= cfg_.gate_threshold && d.t_read_seconds <= remaining_budget;
+            if (d.fire) {
+                remaining_budget -= d.t_read_seconds;
+            }
+        }
+        return decisions;
+    }
+
+    const SpeculativeGateConfig & config() const { return cfg_; }
+
+private:
+    SpeculativeGateConfig cfg_;
+    std::unordered_map<ExpertKey, double, ExpertKeyHash> confidence_;
+    std::unordered_map<ExpertKey, int, ExpertKeyHash>    counts_;
+    std::unordered_map<int32_t, std::vector<int32_t>>    pending_;
+};
+
+} // namespace svram
