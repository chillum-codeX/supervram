+// Main-thread only (called from plan(), before that tensor's real hit/miss resolution runs for
+// this step): commit any speculative reads the background worker finished since the last call.
+// Re-verifies both the expert and the victim slot are still free at commit time -- if a real
+// miss claimed either in the meantime, the read is discarded (spec_wasted), never overwriting
+// state a real access already established. A committed fill registers as a genuine hit if this
+// step's required-miss resolution (which runs right after this, still inside plan()) turns out
+// to need that exact expert.
+static void ggml_backend_sched_expert_cache_spec_commit(struct ggml_backend_sched_expert_cache * cache, ggml_backend_t split_backend) {
+#if defined(__linux__)
+    std::vector<ggml_backend_sched_expert_cache::ggml_spec_job *> done;
+    {
+        std::lock_guard<std::mutex> lock(cache->spec_mtx);
+        if (cache->spec_done.empty()) {
+            return;
+        }
+        done.swap(cache->spec_done);
+    }
+    for (ggml_backend_sched_expert_cache::ggml_spec_job * job : done) {
+        ggml_backend_sched_expert_tensor & et = *job->et;
+        // Re-verify BOTH sides are still exactly as they were when this job was submitted:
+        // the candidate itself must still be non-resident (a real miss may have fetched it since),
+        // and the victim slot must still hold whatever it held at submit time (job->evicted_expert,
+        // or -1 if it was empty) -- if a real access claimed either in the meantime, discard rather
+        // than clobber state a real access already established.
+        const bool still_valid = job->ok && et.slot_of_expert[job->expert] < 0
+            && et.expert_of_slot[job->victim] == job->evicted_expert
+            && et.last_use[job->victim] == job->evicted_last_use;
+        if (still_valid) {
+            ggml_backend_tensor_set_async(split_backend, et.slots_view ? et.slots_view : et.slots_persist,
+                job->staging + job->head, (size_t) job->victim * et.expert_size, et.expert_size);
+            if (job->evicted_expert >= 0) {
+                et.slot_of_expert[job->evicted_expert] = -1;
+            }
+            et.expert_of_slot[job->victim] = (int32_t) job->expert;
+            et.slot_of_expert[job->expert] = job->victim;
+            et.last_use[job->victim]       = et.tick; // pre-increment tick: stale relative to this step, evictable if truly needed
+            et.use_count[job->victim]      = 0;        // not yet actually used -- a speculative fill earns no LFU credit until a real hit touches it
+            cache->stats.spec_committed++;
+        } else {
+            cache->stats.spec_wasted++;
+        }
+        free(job->staging);
+        delete job;
+    }
+#else
+    GGML_UNUSED(cache); GGML_UNUSED(split_backend);
+#endif
+}
